# Backend only. Copy to .env, then insert your own Database User credentials.
# Never use a VITE_ prefix for MongoDB credentials.
MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@<atlas-cluster-host>/?retryWrites=true&w=majority&appName=WattsHappening
MONGODB_DATABASE=utility_projects_db
MONGODB_PROJECTS_COLLECTION=utility_projects
MONGODB_OVERLAPS_COLLECTION=overlapping_projects
# For the original collection names, use projects and overlaps.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
